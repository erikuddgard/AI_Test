{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/health/database",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/health/database",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/health/database",
      "schedule": "0 16 * * *"
    }
  ]
}
