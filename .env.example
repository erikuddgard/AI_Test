# Exempel endast. Inga verkliga nycklar ska checkas in.
# Lämna båda Supabase-värden tomma för lokal fillagring.
# För Vercel: ange båda säkert i Project Settings > Environment Variables
# för Production och Preview, inte i en fil som checkas in i repot.
SUPABASE_URL=
# Secret key (sb_secret_...) rekommenderas; äldre service_role stöds också.
SUPABASE_SERVICE_ROLE_KEY=

# Valfritt vid lokal utveckling eller på en egen Node-server:
# PORT=8443
# LEAGUE_DATA_DIR=.league-data
# OCR_LANG=eng
